PLANNER_MODEL_NAME=gemini-3.1-flash-lite-preview
CODER_MODEL_NAME=gemini-3.1-flash-lite-preview

# ─── API Keys ─────────────────────────────────────────────
GOOGLE_API_KEY=
GROQ_API_KEY=

# ─── LangSmith Observability ───────────────────────────────
# Get your API key from https://smith.langchain.com/settings
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=nexura-ai

# ─── Usage budget (optional; protects a free-tier quota) ───
# Caps counted over a rolling window across all runs. When reached, the run pauses cleanly; continue with --resume <run_id>.
# Example for a 500-requests/day key: leave a margin. 0 or unset = no cap.
# NEXURA_BUDGET_MAX_REQUESTS=450
# NEXURA_BUDGET_MAX_TOKENS=0
# NEXURA_BUDGET_WINDOW_HOURS=24

# ─── Environment for commands the agent runs ───
# By default they do NOT inherit API keys/tokens (names containing API_KEY, TOKEN, SECRET, PASSWORD, ...).
# NEXURA_SCRUB_ENV=true
# NEXURA_ENV_PASSTHROUGH=GITHUB_TOKEN,NPM_TOKEN   # names to keep, comma separated

# Existing projects: also take test/lint commands from the project's own .github/workflows files (offline; off by default)
# NEXURA_CI_AWARE=true

# With NEXURA_RETRIEVAL_MODE=v2 and a ready index: tell the coder where the functions of the files it sees are used (name-based hints; off by default)
# NEXURA_CODE_GRAPH=true

# If the model keeps refusing the planner's structured request (temporary 503), ask for the plan as plain text (on by default)
# NEXURA_PLANNER_FALLBACK=true
